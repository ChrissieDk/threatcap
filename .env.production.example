# Copy to .env on the server and fill in. chmod 600 .env. Never commit it.
DOMAIN=peregrinet.com                    # DNS A record must point at this server
CONTACT_EMAIL=admin@peregrinet.com       # an address you can receive mail at; push services use it as the contact
POSTGRES_PASSWORD=                       # openssl rand -base64 32
API_KEY=                                 # openssl rand -base64 32 (shared by api and web)

# Sign-up: closed by default. Open it with an invite code to share with friends.
REGISTRATION_OPEN=false
INVITE_CODE=

# Retention starts in dry-run mode. Read the API log once, then set this to false.
RETENTION_DRY_RUN=true

# Optional: free NVD API key (faster severity enrichment). Leave empty to run without one.
NVD_API_KEY=

# Optional email (verification + email alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
