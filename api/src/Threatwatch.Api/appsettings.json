{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=threatwatch;Username=threatwatch;Password=threatwatch"
  },
  "Auth": {
    "ApiKey": ""
  },
  "Ingestion": {
    "AutoStart": true,
    "PollSeconds": 30
  },
  "Alerts": {
    "WebBaseUrl": "http://localhost:3000",
    "AllowPrivateTargets": false,
    "PollSeconds": 60
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Security": "StartTls",
    "Username": "",
    "Password": "",
    "From": "",
    "FromName": "Threatwatch"
  },
  "Osv": {
    "RetentionDays": 90
  },
  "Retention": {
    "Enabled": true,
    "DryRun": true,
    "AdvisoryDays": 180,
    "WithdrawnDays": 30,
    "EventDays": 90,
    "ResolvedIncidentDays": 180,
    "IntervalHours": 24
  },
  "Nvd": {
    "Enabled": true,
    "IntervalMinutes": 60,
    "MaxPerRun": 20,
    "LookbackDays": 30
  },
  "Epss": {
    "FeedPath": "epss_scores-current.csv.gz",
    "IntervalHours": 24
  }
}
